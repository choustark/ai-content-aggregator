<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.choucj</groupId>
	<artifactId>ai-content-aggregator</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ai-content-aggregator</name>
	<description>AI Content Aggregation and Auto-Publishing System</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<langchain4j.version>1.16.0</langchain4j.version>
		<langchain4j.starter.version>1.16.0-beta26</langchain4j.starter.version>
		<jedis.version>7.2.1</jedis.version>
		<jacoco.version>0.8.13</jacoco.version>
		<wx-java.version>4.6.0</wx-java.version>
		<commonmark.version>0.22.0</commonmark.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- LangChain4j Spring Boot Starter -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-spring-boot-starter</artifactId>
			<version>${langchain4j.starter.version}</version>
		</dependency>

		<!-- LangChain4j Redis (embedding store) -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-community-redis-spring-boot-starter</artifactId>
			<version>${langchain4j.starter.version}</version>
		</dependency>
		<dependency>
			<groupId>redis.clients</groupId>
			<artifactId>jedis</artifactId>
			<version>${jedis.version}</version>
		</dependency>

		<!-- LangChain4j core -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j</artifactId>
			<version>${langchain4j.version}</version>
		</dependency>

		<!-- LangChain4j OpenAI (Story 2.3a — DeepSeek + GLM 均兼容 OpenAI API) -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
			<version>${langchain4j.starter.version}</version>
		</dependency>

		<!-- WxJava 微信公众号 SDK -->
		<dependency>
			<groupId>com.github.binarywang</groupId>
			<artifactId>wx-java-mp-spring-boot-starter</artifactId>
			<version>${wx-java.version}</version>
		</dependency>

		<!-- commonmark-java — Markdown → HTML 转换 (Story 3.2 ArticleToWxArticleConverter) -->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
			<version>${commonmark.version}</version>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
			<version>${commonmark.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.springframework.boot</groupId>
									<artifactId>spring-boot-configuration-processor</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>external</excludedGroups>
					<systemPropertyVariables>
						<!-- 默认回归固定使用隔离的 test profile，避免本地运行配置触发外部服务。 -->
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>external-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration combine.self="override">
							<groups>external</groups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
			Story 10.15: 生产 External 验收门禁 (release acceptance gate).

			双闸设计:
			1. preflight 前置检查 — ReleaseAcceptancePreflightTest 绑定在 process-test-classes 阶段,
			   先于必需套件执行; 微信凭据 / Redis Cluster 三节点 / PHOTO fixture 任一缺失即 FAIL
			   (而非 skip), Maven 失败中断, 后续必需测试不执行。
			2. verify 守门器 — exec-maven-plugin 在 verify 阶段运行 scripts/verify_release_acceptance.py,
			   解析 surefire XML 断言必需测试集 0 skipped / 0 failures / 0 errors 且报告齐全,
			   缺口即非零退出 (surefire 无法原生把 skipped 计为失败, 故由脚本独立裁决)。
			   守门器必需类清单由下方 gate execution 的 <argument> 显式传入 (pom 为单一事实源)。

			必需测试集 (2026-10-23 裁决, 共 4 项): preflight + 真实 Redis Cluster TaskQueue 恢复 +
			PHOTO-only 成功交付 E2E + 失败四层收敛 E2E。其余 external 测试保持开发 smoke 定位
			(-Pexternal-tests 入口 assume-skip 语义不变)。

			陈旧报告防御 (review 修复): initialize 阶段先清除上一次运行遗留的必需集 surefire 报告,
			使 -DskipTests / -Dtest 覆盖等跳过场景因「报告缺失」在守门器处暴露, 而非消费陈旧绿报告假 PASS。

			surefire 配置 combine.self="override" 抹掉默认的 excludedGroups=external 排除
			(必需类均为 @Tag("external"), 不清除会被反向排除), 并重新声明隔离的 test profile;
			forkCount/threadCount/parallel 固定单线程顺序执行, 保证报告可解析; runOrder=alphabetical
			保证执行顺序稳定。
		-->
		<profile>
			<id>release-acceptance</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-clean-plugin</artifactId>
						<executions>
							<!-- 陈旧报告防御: 必需集报告只认本次运行的产出, 上次遗留一律先清除 -->
							<execution>
								<id>purge-stale-acceptance-reports</id>
								<phase>initialize</phase>
								<goals>
									<goal>clean</goal>
								</goals>
								<configuration>
									<excludeDefaultDirectories>true</excludeDefaultDirectories>
									<filesets>
										<fileset>
											<directory>${project.build.directory}/surefire-reports</directory>
											<includes>
												<include>TEST-com.choucj.aiaggregator.release.*.xml</include>
												<include>TEST-com.choucj.aiaggregator.publish.e2e.WeChatDeliveryE2EFailureTest.xml</include>
												<include>TEST-com.choucj.aiaggregator.publish.wechat.DraftPublishClaimIntegrationTest.xml</include>
												<include>TEST-com.choucj.aiaggregator.task.queue.TaskQueueRecoveryIntegrationTest.xml</include>
											<include>TEST-com.choucj.aiaggregator.task.queue.TaskQueueRetryIntegrationTest.xml</include>
											</includes>
										</fileset>
									</filesets>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration combine.self="override">
							<!-- 单线程顺序执行: 必需套件共享真实外部环境, 且保证 surefire 报告可解析 -->
							<forkCount>1</forkCount>
							<reuseForks>true</reuseForks>
							<threadCount>1</threadCount>
							<parallel>none</parallel>
							<runOrder>alphabetical</runOrder>
							<systemPropertyVariables>
								<!-- 与默认回归一致, 固定使用隔离的 test profile, 不读本地运行配置 -->
								<spring.profiles.active>test</spring.profiles.active>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<!-- 禁用默认全量执行: release 门禁只运行显式必需清单, 不夹带其它测试 -->
							<execution>
								<id>default-test</id>
								<phase>none</phase>
							</execution>
							<!-- 前置闸: preflight 先行, 任一前置缺失即 FAIL 中断构建 -->
							<execution>
								<id>release-acceptance-preflight</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>test</goal>
								</goals>
								<configuration>
									<test>com.choucj.aiaggregator.release.ReleaseAcceptancePreflightTest</test>
								</configuration>
							</execution>
							<!-- 必需套件: preflight 通过后才执行 -->
							<execution>
								<id>release-acceptance-required</id>
								<phase>test</phase>
								<goals>
									<goal>test</goal>
								</goals>
								<configuration>
									<test>com.choucj.aiaggregator.publish.e2e.WeChatDeliveryE2EFailureTest,com.choucj.aiaggregator.release.WeChatPhotoDeliveryReleaseTest,com.choucj.aiaggregator.publish.wechat.DraftPublishClaimIntegrationTest,com.choucj.aiaggregator.task.queue.TaskQueueRecoveryIntegrationTest,com.choucj.aiaggregator.task.queue.TaskQueueRetryIntegrationTest</test>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<!-- 后置闸: 解析 surefire 报告, 0 skipped / 0 failures / 0 errors + 报告齐全才放行 -->
							<execution>
								<id>release-acceptance-gate</id>
								<phase>verify</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>python3</executable>
									<arguments>
										<argument>${project.basedir}/scripts/verify_release_acceptance.py</argument>
										<argument>${project.build.directory}/surefire-reports</argument>
										<!-- 必需类清单单一事实源: 与上方两个 surefire execution 的 <test> 清单保持一致 -->
										<argument>com.choucj.aiaggregator.release.ReleaseAcceptancePreflightTest</argument>
										<argument>com.choucj.aiaggregator.publish.e2e.WeChatDeliveryE2EFailureTest</argument>
										<argument>com.choucj.aiaggregator.release.WeChatPhotoDeliveryReleaseTest</argument>
										<argument>com.choucj.aiaggregator.publish.wechat.DraftPublishClaimIntegrationTest</argument>
										<argument>com.choucj.aiaggregator.task.queue.TaskQueueRecoveryIntegrationTest</argument>
										<argument>com.choucj.aiaggregator.task.queue.TaskQueueRetryIntegrationTest</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>story-5.1-coverage</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>${jacoco.version}</version>
						<executions>
							<execution>
								<id>story-5.1-coverage-check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
								<configuration>
									<rules>
										<rule>
											<element>PACKAGE</element>
											<includes>
												<include>com.choucj.aiaggregator.content.embedding</include>
											</includes>
											<limits>
												<limit>
													<counter>INSTRUCTION</counter>
													<value>COVEREDRATIO</value>
													<minimum>0.80</minimum>
												</limit>
											</limits>
										</rule>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
